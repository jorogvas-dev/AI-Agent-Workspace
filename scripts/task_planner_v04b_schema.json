{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic Task Planner v0.4b",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "variables", "steps"],
  "properties": {
    "version": {"const": "0.4b"},
    "variables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {"enum": ["number", "search_results"]},
          "unit": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "args"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
          "operation": {"enum": ["search_knowledge", "extract_number", "calculate", "write_report", "verify_file"]},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "args": {"type": "object"}
        }
      }
    }
  },
  "operationRules": {
    "search_knowledge": {
      "required": ["query", "limit", "save_as"],
      "save_asType": "search_results",
      "limit": "integer 1..10"
    },
    "extract_number": {
      "required": ["from", "field", "source", "patterns", "save_as"],
      "save_asType": "number",
      "rules": ["field equals save_as", "patterns are 1..3 regexes with exactly one capture group", "source must be one document name"]
    },
    "calculate": {
      "required": ["operation", "operands", "save_as"],
      "operation": ["add", "subtract", "multiply", "divide"],
      "operands": "exactly two finite numbers or declared number variables",
      "save_asType": "number"
    },
    "write_report": {
      "required": ["path", "content"],
      "path": "relative path under output/ or temp/",
      "placeholders": "simple {number_variable} names only"
    },
    "verify_file": {
      "required": ["path", "reference"],
      "reference": "a dependent write_report step for the same path",
      "sha256": "optional 64-character hexadecimal digest"
    }
  },
  "securityRules": [
    "No commands, scripts, subprocesses, arbitrary URLs, or unrestricted network destinations",
    "Plans are validated and simulated in memory only in v0.4b",
    "All dependencies must exist and form an acyclic graph",
    "No more than 10 steps are permitted"
  ]
}
